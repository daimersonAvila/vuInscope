# Copy to .env (never commit it). Generate values as shown below.
APP_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
# python scripts/hash_password.py   -> paste the printed hash (quote it, it contains '$')
ADMIN_PASSWORD_HASH=
ALLOWED_HOSTS=your-domain.example
# Number of reverse proxies in front of the app (so client IPs / https are read correctly)
TRUSTED_PROXIES=1
DATABASE_PATH=/data/vulnscope.db
MAX_UPLOAD_MB=25
# Public, key-less AI endpoint (OpenAI-compatible). Set AI_ENABLED=0 to disable all external calls.
AI_ENABLED=1
AI_URL=https://text.pollinations.ai/openai
AI_MODEL=openai
AI_API_KEY=
